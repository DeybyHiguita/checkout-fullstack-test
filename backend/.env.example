# === App ===
NODE_ENV=development
PORT=3000
API_PREFIX=api/v1
CORS_ORIGIN=http://localhost:5173

# === Base de datos (PostgreSQL) ===
# En local se puede usar el docker-compose incluido.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/checkout
# Alternativa por partes (si no se usa DATABASE_URL):
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=checkout

# === Pasarela de pagos (Sandbox) ===
# Nunca commitear valores reales. Se cargan como secrets en el proveedor de deploy.
# Modo: 'real' (requiere llaves) o 'simulated' (demo local sin red).
# Si se deja vacío: usa 'real' cuando hay GATEWAY_BASE_URL, 'simulated' si no.
PAYMENT_GATEWAY_MODE=simulated
GATEWAY_BASE_URL=
GATEWAY_PUBLIC_KEY=
GATEWAY_PRIVATE_KEY=
GATEWAY_EVENTS_KEY=
GATEWAY_INTEGRITY_SECRET=

# === Reglas de negocio (fees) ===
# Fee base fijo en centavos y fee de envío por defecto en centavos.
BASE_FEE_IN_CENTS=350000
DEFAULT_DELIVERY_FEE_IN_CENTS=800000
