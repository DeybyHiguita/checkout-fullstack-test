  "info": {
    "title": "Checkout Full-Stack API",
    "description": "API del checkout de un producto pagado con pasarela de pagos (Sandbox).",
    "version": "1.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "schemas": {
      "CustomerDto": {
        "type": "object",
        "properties": {
          "fullName": {
            "type": "string",
            "minLength": 3,
            "maxLength": 150
          },
          "email": {
            "type": "string",
            "maxLength": 150,
            "format": "email"
          },
          "documentType": {
            "type": "string",
            "minLength": 2,
            "maxLength": 10
          },
          "documentNumber": {
            "type": "string",
            "pattern": "^\\d{6,15}$"
          },
          "phoneNumber": {
            "type": "string",
            "minLength": 7,
            "maxLength": 20
          }
        },
        "required": [
          "fullName",
          "email",
          "documentType",
          "documentNumber",
          "phoneNumber"
        ]
      },
      "DeliveryDto": {
        "type": "object",
        "properties": {
          "addressLine": {
            "type": "string",
            "maxLength": 200
          },
          "city": {
            "type": "string",
            "maxLength": 100
          },
          "region": {
            "type": "string",
            "maxLength": 100
          },
          "postalCode": {
            "type": "string",
            "maxLength": 20
          },
          "country": {
            "type": "string",
            "minLength": 2,
            "maxLength": 2
          }
        },
        "required": [
          "addressLine",
          "city",
          "region"
        ]
      },
      "CreateTransactionDto": {
        "type": "object",
        "properties": {
          "productId": {
            "type": "string",
            "format": "uuid"
          },
          "customer": {
            "$ref": "#/components/schemas/CustomerDto"
          },
          "delivery": {
            "$ref": "#/components/schemas/DeliveryDto"
          }
        },
        "required": [
          "productId",
          "customer",
          "delivery"
        ]
      },
      "PayTransactionDto": {
        "type": "object",
        "properties": {
          "cardToken": {
            "type": "string"
          },
          "acceptanceToken": {
            "type": "string"
          },
          "installments": {
            "type": "number",
            "minimum": 1,
            "maximum": 36
          }
        },
        "required": [
          "cardToken",
          "acceptanceToken"
        ]
      }
    }
  }
}